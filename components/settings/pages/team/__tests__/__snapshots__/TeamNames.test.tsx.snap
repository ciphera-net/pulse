exports[`the Team page with the team-names beta off: today's DOM, byte for byte > draws the change role dialog as today 1`] = `"<div role="dialog" aria-label="Change Teammate 3f2a9c1b's role?"><h3>Change Teammate 3f2a9c1b's role?</h3><div class="space-y-4"><p class="text-sm text-muted-foreground">They get the role you pick at once.</p><div class="space-y-1.5"><label for="team-change-role" class="text-xs font-medium text-muted-foreground">Role</label><select id="team-change-role"><option value=""></option><option value="member" title="Sees every site's stats and billing, and can export stats. Can't change settings.">Member</option><option value="admin" title="Changes sites, goals and connected services, and invites and removes people. Can see billing but not change it.">Admin</option></select></div><div class="flex justify-end gap-2 pt-1"><button data-variant="outline">Cancel</button><button data-variant="default" disabled="">Change role</button></div></div></div>"`;

