exports[`Developers with the team-names beta off: today's DOM, byte for byte > draws the page as today, and the same with the beta on in another team or a session holding names 1`] = `"<div data-kit="" class="space-y-12 [&amp;_[role=switch][aria-checked=true]>span]:bg-[#fff]"><section data-kit-section="API keys"><header class="flex flex-wrap items-start justify-between gap-x-6 gap-y-2 pb-3"><div class="min-w-0"><h2 class="flex items-center gap-2 text-base font-semibold tracking-tight text-foreground"><span data-kit-icon="heading" class="flex shrink-0 [&amp;_svg]:h-[18px] [&amp;_svg]:w-[18px] text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 256 256"><path d="M216.57,39.43A80,80,0,0,0,83.91,120.78L28.69,176A15.86,15.86,0,0,0,24,187.31V216a16,16,0,0,0,16,16H72a8,8,0,0,0,8-8V208H96a8,8,0,0,0,8-8V184h16a8,8,0,0,0,5.66-2.34l9.56-9.57A79.73,79.73,0,0,0,160,176h.1A80,80,0,0,0,216.57,39.43ZM224,98.1c-1.09,34.09-29.75,61.86-63.89,61.9H160a63.7,63.7,0,0,1-23.65-4.51,8,8,0,0,0-8.84,1.68L116.69,168H96a8,8,0,0,0-8,8v16H72a8,8,0,0,0-8,8v16H40V187.31l58.83-58.82a8,8,0,0,0,1.68-8.84A63.72,63.72,0,0,1,96,95.92c0-34.14,27.81-62.8,61.9-63.89A64,64,0,0,1,224,98.1ZM192,76a12,12,0,1,1-12-12A12,12,0,0,1,192,76Z"></path></svg></span>API keys</h2><p class="mt-1 max-w-[60ch] text-sm text-muted-foreground">A key lets a script or another tool read stats for the sites you pick. It can't change anything.</p></div><div data-kit-aside="" class="shrink-0 pt-0.5"><button data-variant="outline" data-size="sm">New API key</button></div></header><div class="border-y border-border"><div class="divide-y divide-border"><div data-kit-row="" class="grid grid-cols-1 gap-x-6 gap-y-2 py-4 md:items-center md:grid-cols-[minmax(0,1fr)_auto]"><div class="min-w-0"><div class="min-w-0"><span class="block text-sm font-medium text-foreground">No API keys yet</span><p class="mt-0.5 max-w-[56ch] text-xs text-muted-foreground">Create one to read your stats from a script, a dashboard or a spreadsheet.</p></div></div></div></div></div></section><section data-kit-section="AI assistants"><header class="flex flex-wrap items-start justify-between gap-x-6 gap-y-2 pb-3"><div class="min-w-0"><h2 class="flex items-center gap-2 text-base font-semibold tracking-tight text-foreground"><span data-kit-icon="heading" class="flex shrink-0 [&amp;_svg]:h-[18px] [&amp;_svg]:w-[18px] text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 256 256"><path d="M200,48H136V16a8,8,0,0,0-16,0V48H56A32,32,0,0,0,24,80V192a32,32,0,0,0,32,32H200a32,32,0,0,0,32-32V80A32,32,0,0,0,200,48Zm16,144a16,16,0,0,1-16,16H56a16,16,0,0,1-16-16V80A16,16,0,0,1,56,64H200a16,16,0,0,1,16,16Zm-52-56H92a28,28,0,0,0,0,56h72a28,28,0,0,0,0-56Zm-24,16v24H116V152ZM80,164a12,12,0,0,1,12-12h8v24H92A12,12,0,0,1,80,164Zm84,12h-8V152h8a12,12,0,0,1,0,24ZM72,108a12,12,0,1,1,12,12A12,12,0,0,1,72,108Zm88,0a12,12,0,1,1,12,12A12,12,0,0,1,160,108Z"></path></svg></span>AI assistants</h2><p class="mt-1 max-w-[60ch] text-sm text-muted-foreground">Let an AI assistant read stats for the sites you pick. It can't change anything.</p></div></header><div class="border-y border-border"><div class="divide-y divide-border"><div data-kit-block="" class="py-4"><div class="flex flex-col gap-5"><p class="text-sm text-muted-foreground">Pick your assistant, then follow its steps to connect the Pulse Analytics MCP server.</p><div data-railgrid="true" class="grid-cols-4 sm:grid-cols-8"><button type="button" aria-pressed="true" class="group relative flex cursor-pointer flex-col items-center justify-center gap-2 bg-card px-2 py-4 text-center transition-colors ease-apple bg-accent ring-1 ring-inset ring-primary"><img alt="" width="28" height="28" class="h-7 w-7 object-contain" data-client="claude" src="/connect/claude-v1.svg"><span class="text-[11px] font-medium leading-tight text-foreground">Claude</span></button><button type="button" aria-pressed="false" class="group relative flex cursor-pointer flex-col items-center justify-center gap-2 bg-card px-2 py-4 text-center transition-colors ease-apple hover:bg-muted"><img alt="" width="28" height="28" class="h-7 w-7 object-contain" data-client="claude-code" src="/connect/claude-v1.svg"><span class="text-[11px] font-medium leading-tight text-muted-foreground">Claude Code</span></button><button type="button" aria-pressed="false" class="group relative flex cursor-pointer flex-col items-center justify-center gap-2 bg-card px-2 py-4 text-center transition-colors ease-apple hover:bg-muted"><img alt="" width="28" height="28" class="h-7 w-7 object-contain" data-client="chatgpt" src="/connect/chatgpt-v1.png"><span class="text-[11px] font-medium leading-tight text-muted-foreground">ChatGPT</span></button><button type="button" aria-pressed="false" class="group relative flex cursor-pointer flex-col items-center justify-center gap-2 bg-card px-2 py-4 text-center transition-colors ease-apple hover:bg-muted"><img alt="" width="28" height="28" class="h-7 w-7 object-contain" data-client="cursor" src="/connect/cursor-v1.png"><span class="text-[11px] font-medium leading-tight text-muted-foreground">Cursor</span></button><button type="button" aria-pressed="false" class="group relative flex cursor-pointer flex-col items-center justify-center gap-2 bg-card px-2 py-4 text-center transition-colors ease-apple hover:bg-muted"><img alt="" width="28" height="28" class="h-7 w-7 object-contain" data-client="vscode" src="/connect/vscode-v1.png"><span class="text-[11px] font-medium leading-tight text-muted-foreground">VS Code</span></button><button type="button" aria-pressed="false" class="group relative flex cursor-pointer flex-col items-center justify-center gap-2 bg-card px-2 py-4 text-center transition-colors ease-apple hover:bg-muted"><img alt="" width="28" height="28" class="h-7 w-7 object-contain" data-client="lechat" src="/connect/mistral-v1.png"><span class="text-[11px] font-medium leading-tight text-muted-foreground">Le Chat</span></button><button type="button" aria-pressed="false" class="group relative flex cursor-pointer flex-col items-center justify-center gap-2 bg-card px-2 py-4 text-center transition-colors ease-apple hover:bg-muted"><img alt="" width="28" height="28" class="h-7 w-7 object-contain" data-client="copilot" src="/connect/copilotstudio-v1.png"><span class="text-[11px] font-medium leading-tight text-muted-foreground">Copilot Studio</span></button><button type="button" aria-pressed="false" class="group relative flex cursor-pointer flex-col items-center justify-center gap-2 bg-card px-2 py-4 text-center transition-colors ease-apple hover:bg-muted"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true" class="h-7 w-7 text-muted-foreground"><path d="M144,128a16,16,0,1,1-16-16A16,16,0,0,1,144,128ZM60,112a16,16,0,1,0,16,16A16,16,0,0,0,60,112Zm136,0a16,16,0,1,0,16,16A16,16,0,0,0,196,112Z"></path></svg><span class="text-[11px] font-medium leading-tight text-muted-foreground">Other</span></button></div><ol aria-label="Connect Claude" class="flex flex-col gap-5"><li class="grid grid-cols-1 gap-4 md:grid-cols-2 md:items-start"><div class="flex items-start gap-3"><span class="flex h-6 w-6 shrink-0 items-center justify-center border border-border text-xs font-medium tabular-nums text-muted-foreground">1</span><div class="min-w-0"><p class="text-sm font-medium text-foreground">Add a custom connector</p><p class="mt-0.5 text-xs text-muted-foreground">In Claude, open Customize → Connectors, click +, then Add custom connector.</p></div></div></li><li class="grid grid-cols-1 gap-4 md:grid-cols-2 md:items-start border-t border-border pt-5"><div class="flex items-start gap-3"><span class="flex h-6 w-6 shrink-0 items-center justify-center border border-border text-xs font-medium tabular-nums text-muted-foreground">2</span><div class="min-w-0"><p class="text-sm font-medium text-foreground">Paste the server URL</p><p class="mt-0.5 text-xs text-muted-foreground">Leave Advanced settings empty.</p></div></div><div class="rounded-none border border-border bg-background"><div class="flex items-center justify-between border-b border-border px-4 py-2.5"><div class="flex items-center gap-2 min-w-0"><span class="text-micro-label uppercase text-muted-foreground truncate">Server URL</span></div><button type="button" aria-label="Copy Server URL for step 2" class="flex items-center gap-1.5 shrink-0 text-xs font-medium text-muted-foreground hover:text-foreground transition-colors cursor-pointer ease-apple"><span></span>Copy<span aria-live="polite" class="sr-only"></span></button></div><pre class="px-4 py-4 text-[13px] leading-relaxed font-mono text-muted-foreground whitespace-pre-wrap break-words overflow-x-auto selection:bg-primary/30">https://pulse-api-staging.ciphera.net/mcp</pre></div></li><li class="grid grid-cols-1 gap-4 md:grid-cols-2 md:items-start border-t border-border pt-5"><div class="flex items-start gap-3"><span class="flex h-6 w-6 shrink-0 items-center justify-center border border-border text-xs font-medium tabular-nums text-muted-foreground">3</span><div class="min-w-0"><p class="text-sm font-medium text-foreground">Connect</p><p class="mt-0.5 text-xs text-muted-foreground">Click Add, then Connect. Pulse opens: choose which sites it can read, then click Allow.</p></div></div></li><li class="grid grid-cols-1 gap-4 md:grid-cols-2 md:items-start border-t border-border pt-5"><div class="flex items-start gap-3"><span class="flex h-6 w-6 shrink-0 items-center justify-center border border-border text-xs font-medium tabular-nums text-muted-foreground">4</span><div class="min-w-0"><p class="text-sm font-medium text-foreground">All done</p><p class="mt-0.5 text-xs text-muted-foreground">Ask Claude about your analytics, for example “What were my top referrers this month?”</p></div></div></li></ol></div></div></div></div></section><section data-kit-section="Connected assistants"><header class="flex flex-wrap items-start justify-between gap-x-6 gap-y-2 pb-3"><div class="min-w-0"><h2 class="flex items-center gap-2 text-base font-semibold tracking-tight text-foreground"><span data-kit-icon="heading" class="flex shrink-0 [&amp;_svg]:h-[18px] [&amp;_svg]:w-[18px] text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 256 256"><path d="M149.66,138.34a8,8,0,0,0-11.32,0L120,156.69,99.31,136l18.35-18.34a8,8,0,0,0-11.32-11.32L88,124.69,69.66,106.34a8,8,0,0,0-11.32,11.32L64.69,124,41.37,147.31a32,32,0,0,0,0,45.26l5.38,5.37-28.41,28.4a8,8,0,0,0,11.32,11.32l28.4-28.41,5.37,5.38a32,32,0,0,0,45.26,0L132,191.31l6.34,6.35a8,8,0,0,0,11.32-11.32L131.31,168l18.35-18.34A8,8,0,0,0,149.66,138.34Zm-52.29,65a16,16,0,0,1-22.62,0L52.69,181.25a16,16,0,0,1,0-22.62L76,135.31,120.69,180Zm140.29-185a8,8,0,0,0-11.32,0l-28.4,28.41-5.37-5.38a32.05,32.05,0,0,0-45.26,0L124,64.69l-6.34-6.35a8,8,0,0,0-11.32,11.32l80,80a8,8,0,0,0,11.32-11.32L191.31,132l23.32-23.31a32,32,0,0,0,0-45.26l-5.38-5.37,28.41-28.4A8,8,0,0,0,237.66,18.34Zm-34.35,79L180,120.69,135.31,76l23.32-23.31a16,16,0,0,1,22.62,0l22.06,22A16,16,0,0,1,203.31,97.37Z"></path></svg></span>Connected assistants</h2><p class="mt-1 max-w-[60ch] text-sm text-muted-foreground">Each one reads only the sites it was given. It ends after 30 days without activity, or when the person who connected it leaves the team or is no longer the owner or an admin.</p></div></header><div class="border-y border-border"><div class="divide-y divide-border"><div data-testid="connection-row-tn-c1"><div data-kit-row="" class="grid grid-cols-1 gap-x-6 gap-y-2 py-4 md:items-center md:grid-cols-[minmax(0,1fr)_auto]"><div class="min-w-0 flex items-start gap-3"><span data-kit-icon="logo" class="flex h-5 w-4 shrink-0 items-center justify-center [&amp;_svg]:h-4 [&amp;_svg]:w-4"><img alt="" width="16" height="16" class="h-4 w-4 object-contain" data-brand="claude" src="/connect/claude-