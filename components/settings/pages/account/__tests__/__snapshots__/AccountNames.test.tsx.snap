me" placeholder="Your name" maxlength="100" value="Alex Morgan"></div></div><form class="divide-y divide-border"><div data-kit-row="" class="grid grid-cols-1 gap-x-6 gap-y-2 py-4 md:items-center md:grid-cols-[minmax(200px,32%)_minmax(0,1fr)_auto]"><div class="min-w-0"><div class="min-w-0"><span class="block text-sm font-medium text-foreground">Email</span><p class="mt-0.5 max-w-[56ch] text-xs text-muted-foreground">Changing it needs your password, then a click on a link sent to the new address.</p></div></div><div class="min-w-0 md:max-w-md"><span class="block truncate text-sm text-foreground">alex.morgan@example.com</span></div><div class="flex items-center gap-2 md:justify-self-end"><button data-variant="outline" data-size="sm" type="button">Change email</button></div></div></form></div></div></section>"`;

exports[`Account with the team-names beta off everywhere: today's DOM, byte for byte > draws the unlocked page as today, with and without the provider around it 2`] = `"<div data-kit="" class="space-y-12 [&amp;_[role=switch][aria-checked=true]>span]:bg-[#fff]"><section data-kit-section="Profile"><header class="flex flex-wrap items-start justify-between gap-x-6 gap-y-2 pb-3"><div class="min-w-0"><h2 class="flex items-center gap-2 text-base font-semibold tracking-tight text-foreground"><span data-kit-icon="heading" class="flex shrink-0 [&amp;_svg]:h-[18px] [&amp;_svg]:w-[18px] text-primary"></span>Profile</h2><p class="mt-1 max-w-[60ch] text-sm text-muted-foreground">Unlocked on this device. Your name and email are decrypted here only.</p></div><div data-kit-aside="" class="shrink-0 pt-0.5"><button data-variant="outline" data-size="sm">Lock</button></div></header><div class="border-y border-border"><div class="divide-y divide-border"><div data-kit-row="" class="grid grid-cols-1 gap-x-6 gap-y-2 py-4 md:items-center md:grid-cols-[minmax(200px,32%)_minmax(0,1fr)_auto]"><div class="min-w-0"><div class="min-w-0"><span class="block text-sm font-medium text-foreground">Avatar</span><p class="mt-0.5 max-w-[56ch] text-xs text-muted-foreground">A random pattern made for your account. Shown in Pulse, and on Ciphera ID when you pick an account.</p></div></div><div class="min-w-0 md:max-w-md"><span data-testid="avatar"></span></div><div class="flex items-center gap-2 md:justify-self-end"><button data-variant="outline" data-size="sm">Generate a new avatar</button></div></div><div data-kit-row="" class="grid grid-cols-1 gap-x-6 gap-y-2 py-4 md:items-center md:grid-cols-[minmax(200px,32%)_minmax(0,1fr)_auto]"><div class="min-w-0"><div class="min-w-0"><label for="account-display-name" class="block text-sm font-medium text-foreground">Your name</label><p class="mt-0.5 max-w-[56ch] text-xs text-muted-foreground">Shown in your account menu. Your team doesn't see it: it stays in your encrypted profile.</p></div></div><div class="min-w-0 md:max-w-md"><input id="account-display-name" placeholder="Your name" maxlength="100" value="Alex Morgan"></div></div><form class="divide-y divide-border"><div data-kit-row="" class="grid grid-cols-1 gap-x-6 gap-y-2 py-4 md:items-center md:grid-cols-[minmax(200px,32%)_minmax(0,1fr)_auto]"><div class="min-w-0"><div class="min-w-0"><span class="block text-sm font-medium text-foreground">Email</span><p class="mt-0.5 max-w-[56ch] text-xs text-muted-foreground">Changing it needs your password, then a click on a link sent to the new address.</p></div></div><div class="min-w-0 md:max-w-md"><span class="block truncate text-sm text-foreground">alex.morgan@example.com</span></div><div class="flex items-center gap-2 md:justify-self-end"><button data-variant="outline" data-size="sm" type="button">Change email</button></div></div></form></div></div></section><div data-testid="savebar" data-dirty="false"></div><section data-kit-section="Display"><header class="flex flex-wrap items-start justify-between gap-x-6 gap-y-2 pb-3"><div class="min-w-0"><h2 class="flex items-center gap-2 text-base font-semibold tracking-tight text-foreground"><span data-kit-icon="heading" class="flex shrink-0 [&amp;_svg]:h-[18px] [&amp;_svg]:w-[18px] text-primary"></span>Display</h2><p class="mt-1 max-w-[60ch] text-sm text-muted-foreground">How Pulse looks and shows times to you, on every device.</p></div></header><div class="border-y border-border"><div class="divide-y divide-border"><div data-kit-row="" class="grid grid-cols-1 gap-x-6 gap-y-2 py-4 md:items-center md:grid-cols-[minmax(200px,32%)_minmax(0,1fr)_auto]"><div class="min-w-0"><div class="min-w-0"><span class="block text-sm font-medium text-foreground">Show times in</span><p class="mt-0.5 max-w-[56ch] text-xs text-muted-foreground">Changes only how times show to you. Daily totals always follow each site's timezone, set on General.</p></div></div><div class="min-w-0 md:max-w-md"><div role="radiogroup"></div></div></div><div data-kit-row="" class="grid grid-cols-1 gap-x-6 gap-y-2 py-4 md:items-center md:grid-cols-[minmax(200px,32%)_minmax(0,1fr)_auto]"><div class="min-w-0"><div class="min-w-0"><span class="block text-sm font-medium text-foreground">Theme</span><p class="mt-0.5 max-w-[56ch] text-xs text-muted-foreground">Saved to your account, so every device you sign in on uses it.</p></div></div><div class="min-w-0 md:max-w-md"><div data-testid="theme-picker"></div></div></div></div></div></section><section data-kit-section="Sign-in and security"><header class="flex flex-wrap items-start justify-between gap-x-6 gap-y-2 pb-3"><div class="min-w-0"><h2 class="flex items-center gap-2 text-base font-semibold tracking-tight text-foreground"><span data-kit-icon="heading" class="flex shrink-0 [&amp;_svg]:h-[18px] [&amp;_svg]:w-[18px] text-primary"></span>Sign-in and security</h2><p class="mt-1 max-w-[60ch] text-sm text-muted-foreground">Your password never leaves your browser. Ciphera checks it with OPAQUE, so its servers never see it.</p></div></header><div class="border-y border-border"><div class="divide-y divide-border"><div data-kit-row="" class="grid grid-cols-1 gap-x-6 gap-y-2 py-4 md:items-center md:grid-cols-[minmax(0,1fr)_auto]"><div class="min-w-0"><div class="min-w-0"><span class="block text-sm font-medium text-foreground">Password</span><p class="mt-0.5 max-w-[56ch] text-xs text-muted-foreground">Changing it signs you out everywhere, this browser too.</p></div></div><div class="flex items-center gap-2 md:justify-self-end"><button data-variant="outline" data-size="sm">Change password</button></div></div><div data-kit-row="" class="grid grid-cols-1 gap-x-6 gap-y-2 py-4 md:items-center md:grid-cols-[minmax(0,1fr)_auto]"><div class="min-w-0"><div class="min-w-0"><span class="block text-sm font-medium text-foreground">Two-factor authentication</span><p class="mt-0.5 max-w-[56ch] text-xs text-muted-foreground"><span data-kit-status="off" class="inline-flex items-center gap-1.5"><span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-neutral-400"></span><span>Off</span></span> · A 6-digit code from an authenticator app, asked for after your password.</p></div></div><div class="flex items-center gap-2 md:justify-self-end"><button data-variant="outline" data-size="sm">Turn on</button></div></div><div data-kit-row="" class="grid grid-cols-1 gap-x-6 gap-y-2 py-4 md:items-center md:grid-cols-[minmax(0,1fr)_auto]"><div class="min-w-0"><div class="min-w-0"><span class="block text-sm font-medium text-foreground">Passkey</span><p class="mt-0.5 max-w-[56ch] text-xs text-muted-foreground"><span data-kit-status="off" class="inline-flex items-center gap-1.5"><span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-neutral-400"></span><span>No passkey yet</span></span> · You can add one. It asks for your email and password once.</p></div></div><div class="flex items-center gap-2 md:justify-self-end"><button data-variant="outline" data-size="sm">Add passkey</button></div></div></div></div></section><section data-kit-section="Recovery"><header class="flex flex-wrap items-start justify-between gap-x-6 gap-y-2 pb-3"><div class="min-w-0"><h2 class="flex items-center gap-2 text-base font-semibold tracking-tight text-foreground"><span data-kit-icon="heading" class="flex shrink-0 [&amp;_svg]:h-[18px] [&amp;_svg]:w-[18px] text-primary"></span>Recovery</h2><p class="mt-1 max-w-[60ch] text-sm text-muted-foreground">Ways back in if you forget your password or lose your authenticator app.</p></div></header><div class="border-y border-border"><div class="divide-y divide-border"><div data-kit-row="" class="grid grid-cols-1 gap-x-6 gap-y-2 py-4 md:items-center md:grid-cols-[minmax(0,1fr)_auto]"><div class="min-w-0"><div class="min-w-0"><span class="block text-sm font-medium text-foreground">Recovery phrase</span><p class="mt-0.5 max-w-[56ch] text-xs text-muted-foreground"><span data-kit-status="live" class="inline-flex items-center gap-1.5"><span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-primary"></span><span class="text-primary">Set up</span></span> · Lets you set a new password if you forget yours. A new phrase replaces this one.</p></div></div><div class="flex items-center gap-2 md:justify-self-end"><button data-variant="outline" data-size="sm">Replace phrase</button></div></div><div data-kit-row="" class="grid grid-cols-1 gap-x-6 gap-y-2 py-4 md:items-center md:grid-cols-[minmax(0,1fr)_auto]"><div class="min-w-0"><div class="min-w-0"><span class="block text-sm font-medium text-foreground">Recovery codes</span><p class="mt-0.5 max-w-[56ch] text-xs text-muted-foreground">Turn on two-factor authentication to get recovery codes.</p></div></div><div class="flex items-center gap-2 md:justify-self-end"><button data-variant="outline" data-size="sm" aria-haspopup="dialog" disabled="">Replace codes</button></div></div></div></div></section><section data-kit-section="Devices"><header class="flex flex-wrap items-start justify-between gap-x-6 gap-y-2 pb-3"><div class="min-w-0"><h2 class="flex items-center gap-2 text-base font-semibold tracking-tight text-foreground"><span data-kit-icon="heading" class="flex shrink-0 [&amp;_svg]:h-[18px] [&amp;_svg]:w-[18px] text-primary"></span>Devices</h2><p class="mt-1 max-w-[60ch] text-sm text-muted-foreground">Every browser signed in to your account. Signing one out ends its sessions in every Ciphera app; a page already open there can keep working for up to 16 minutes.</p></div></header><div class="border-y border-border"><div class="divide-y divide-border"><div data-account-device="current"><div data-kit-row="" class="grid grid-cols-1 gap-x-6 gap-y-2 py-4 md:items-center md:grid-cols-[minmax(0,1fr)_auto]"><div class="min-w-0"><div class="min-w-0"><span class="block text-sm font-medium text-foreground">This device · Browser 0</span><p class="mt-0.5 max-w-[56ch] text-xs text-muted-foreground"><span data-kit-status="live" class="inline-flex items-center gap-1.5"><span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 rounded-full bg-primary"></span><span class="text-primary">Active now</span></span> · Pulse · Signed in 4 Nov</p></div></div><div class="flex items-center gap-2 md:justify-self-end"><button data-variant="outline" data-size="sm" class="border-destructive/40 text-destructive hover:border-destructive/60 hover:bg-destructive/10 hover:text-destructive">Sign out</button></div></div></div><div data-kit-row="" class="grid grid-cols-1 gap-x-6 gap-y-2 py-4 md:items-center md:grid-cols-[minmax(0,1fr)_auto]"><div class="min-w-0"><div class="min-w-0"><span class="block text-sm font-medium text-foreground">Everywhere else</span><p class="mt-0.5 max-w-[56ch] text-xs text-muted-foreground">Sign out of every browser except this one.</p></div></div><div class="flex items-center gap-2 md:justify-self-end"><button data-variant="outline" data-size="sm" class="border-destructive/40 text-destructive hover:border-destructive/60 hover:bg-destructive/10 hover:text-destructive" disabled="">Sign out everywhere else</button></div></div></div></div></section><section data-kit-section="Security activity"><header class="flex flex-wrap items-start justify-between gap-x-6 gap-y-2 pb-3"><div class="min-w-0"><h2 class="flex items-center gap-2 text-base font-semibold tracking-tight text-foreground"><span data-kit-icon="heading" class="flex shrink-0 [&amp;_svg]:h-[18px] [&amp;_svg]:w-[18px] text-primary"></span>Security activity</h2><p class="mt-1 max-w-[60ch] text-sm text-muted-foreground">Sign-ins and changes to how you sign in, from the last 180 days.</p></div></header><div class="border-y border-border"><div class="divide-y divide-border"><div data-kit-row="" class="grid grid-cols-1 gap-x-6 gap-y-2 py-4 md:items-center md:grid-cols-[minmax(0,1fr)_auto]"><div class="min-w-0"><div class="min-w-0"><span class="block text-sm font-medium text-foreground">No activity yet</span><p class="mt-0.5 max-w-[56ch] text-xs text-muted-foreground">Sign-ins and changes to your password, two-factor and devices show here.</p></div></div></div></div></div></section><section data-kit-section="Danger zone"><header class="flex flex-wrap items-start justify-between gap-x-6 gap-y-2 pb-3"><div class="min-w-0"><h2 class="flex items-center gap-2 text-base font-semibold tracking-tight text-destructive"><span data-kit-icon="heading" class="flex shrink-0 [&amp;_svg]:h-[18px] [&amp;_svg]:w-[18px] text-destructive"></span>Danger zone</h2><p class="mt-1 max-w-[60ch] text-sm text-muted-foreground">You have 6 seconds to undo it.</p></div></header><div class="border-y border-border"><div class="divide-y divide-border"><div data-kit-row="" class="grid grid-cols-1 gap-x-6 gap-y-2 py-4 md:items-center md:grid-cols-[minmax(0,1fr)_auto]"><div class="min-w-0"><div class="min-w-0"><span class="block text-sm font-medium text-foreground">Delete account</span><p class="mt-0.5 max-w-[56ch] text-xs text-muted-foreground">Delete your Ciphera account, here and in every Ciphera app.</p></div></div><div class="flex items-center gap-2 md:justify-self-end"><button data-variant="outline" data-size="sm" class="border-destructive/40 text-destructive hover:border-destructive/60 hover:bg-destructive/10 hover:text-destructive">Delete account</button></div></div></div></div></section></div>"`;
