exports[`Account with the team-names beta off everywhere: today's DOM, byte for byte > draws the locked profile as today 1`] = `"<section data-kit-section="Profile"><header class="flex flex-wrap items-start justify-between gap-x-6 gap-y-2 pb-3"><div class="min-w-0"><h2 class="flex items-center gap-2 text-base font-semibold tracking-tight text-foreground"><span data-kit-icon="heading" class="flex shrink-0 [&amp;_svg]:h-[18px] [&amp;_svg]:w-[18px] text-primary"></span>Profile</h2><p class="mt-1 max-w-[60ch] text-sm text-muted-foreground">Your name and email are locked. Enter your password to see them in this browser. Pulse then keeps the key on this device for up to 30 days, until you lock it or sign out.</p></div><div data-kit-aside="" class="shrink-0 pt-0.5"><button data-variant="outline" data-size="sm">Unlock</button></div></header><div class="border-y border-border"><div class="divide-y divide-border"><div data-kit-row="" class="grid grid-cols-1 gap-x-6 gap-y-2 py-4 md:items-center md:grid-cols-[minmax(200px,32%)_minmax(0,1fr)_auto]"><div class="min-w-0"><div class="min-w-0"><span class="block text-sm font-medium text-foreground">Avatar</span><p class="mt-0.5 max-w-[56ch] text-xs text-muted-foreground">A random pattern made for your account. Shown in Pulse, and on Ciphera ID when you pick an account.</p></div></div><div class="min-w-0 md:max-w-md"><span data-testid="avatar"></span></div><div class="flex items-center gap-2 md:justify-self-end"><button data-variant="outline" data-size="sm">Generate a new avatar</button></div></div><div data-kit-row="" class="grid grid-cols-1 gap-x-6 gap-y-2 py-4 md:items-center md:grid-cols-[minmax(200px,32%)_minmax(0,1fr)_auto]"><div class="min-w-0"><div class="min-w-0"><label for="account-display-name" class="block text-sm font-medium text-foreground">Your name</label><p class="mt-0.5 max-w-[56ch] text-xs text-muted-foreground">Unlock your profile to change your name.</p></div></div><div class="min-w-0 md:max-w-md"><input id="account-display-name" placeholder="Your name" maxlength="100" disabled="" value=""></div></div><form class="divide-y divide-border"><div data-kit-row="" class="grid grid-cols-1 gap-x-6 gap-y-2 py-4 md:items-center md:grid-cols-[minmax(200px,32%)_minmax(0,1fr)_auto]"><div class="min-w-0"><div class="min-w-0"><span class="block text-sm font-medium text-foreground">Email</span><p class="mt-0.5 max-w-[56ch] text-xs text-muted-foreground">Changing it needs your password, then a click on a link sent to the new address.</p></div></div><div class="min-w-0 md:max-w-md"><span class="block truncate text-sm text-muted-foreground">Locked. Unlock above to see it.</span></div><div class="flex items-center gap-2 md:justify-self-end"><button data-variant="outline" data-size="sm" type="button">Change email</button></div></div></form></div></div></section>"`;

