/lib/integration-guides.gen.ts
/public/build-id.json

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# PWA
public/sw.js
public/sw 2.js
public/workbox-*.js
public/swe-worker-*.js

# git worktrees. pulse-backend ignores these (its .gitignore:38); this repo did
# not, so a worktree created here showed up as untracked noise and a `git add -A`
# could commit an entire second checkout of the repo into itself.
.worktrees/

# Local brainstorm mockups — never tracked
.superpowers/
test-results/
playwright-report/

# Playwright: track the config + the read-only settings smoke suite, but keep
# other local *.test.ts / *.spec.ts experiments under tests/ untracked.
tests/*
!tests/settings-smoke.spec.ts
!tests/site-settings-save.spec.ts
!tests/behavior-removal.spec.ts
!tests/oauth-state-clobber.spec.ts
!tests/ws4-tour-audit.spec.ts
!tests/ws4-staging-tour-verify.spec.ts
!tests/visitors-staging.spec.ts
!tests/s3-host-only-session.spec.ts
!tests/callback-failure-staging.spec.ts
!tests/campaigns-header-smoke.spec.ts
!tests/support/
tests/support/*
!tests/support/login.ts
!tests/support/console-errors.ts

# Versioned tracking-script build artifacts (published to CDN, not committed)
dist/scripts/
